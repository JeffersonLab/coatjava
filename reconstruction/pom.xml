<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jlab.clas12</groupId>
  <artifactId>reconstruction</artifactId>
  <version>13.7.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <parent>
    <groupId>org.jlab.clas</groupId>
    <artifactId>coatjava</artifactId>
    <version>13.7.1-SNAPSHOT</version>
  </parent>

  <modules>
    <module>ai</module>
    <module>dc</module>
    <module>tof</module>
    <module>cvt</module>
    <module>ft</module>
    <module>ec</module>
    <module>ltcc</module>
    <module>htcc</module>
    <module>cnd</module>
    <module>rich</module>
    <module>fmt</module>
    <module>eb</module>
    <module>band</module>
    <module>mc</module>
    <module>rtpc</module>
    <module>mltn</module>
    <module>swaps</module>
    <module>raster</module>
    <module>vtx</module>
    <module>urwt</module>
    <module>alert</module>
    <module>bg</module>
    <module>postproc</module>
    <module>recoil</module>
    <module>calib</module>
    <module>uber</module>
    <module>mu</module>
  </modules>

  <build>
    <plugins>
      <!--
        FIXME: these deployment plugins are here in this aggregator POM, so that all its modules
        get deployed the same way, but it also means that _this_ aggregator POM gets deployed too;
        it's not clear if this is actually useful, or correct
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>${project.artifactId}</id>
      <url>${coat.deployment.url}</url>
    </repository>
  </distributionManagement>

</project>
