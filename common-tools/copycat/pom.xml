<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- this POM installs runtime dependencies to our prefix classpath -->

  <artifactId>copycat</artifactId>
  <packaging>pom</packaging>

  <parent>
    <groupId>org.jlab.clas</groupId>
    <artifactId>common-tools</artifactId>
    <version>14.2.4-SNAPSHOT</version>
  </parent>

  <properties>
    <!-- Native PyTorch classifier; overridden per-OS by the profiles below -->
    <djl.pytorch.classifier>linux-x86_64</djl.pytorch.classifier>
  </properties>

  <profiles>
    <!-- Linux x86_64 is the default via the property above; this profile exists only to make the choice explicit/overridable -->
    <profile>
      <id>djl-linux-x86_64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <djl.pytorch.classifier>linux-x86_64</djl.pytorch.classifier>
      </properties>
    </profile>
    <profile>
      <id>djl-osx-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <djl.pytorch.classifier>osx-aarch64</djl.pytorch.classifier>
      </properties>
    </profile>
    <profile>
      <id>djl-win-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <djl.pytorch.classifier>win-x86_64</djl.pytorch.classifier>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <!-- clara -->
    <dependency>
      <groupId>org.jlab.coda</groupId>
      <artifactId>jclara</artifactId>
    </dependency>
    <!-- grapes -->
    <dependency>
      <groupId>org.jlab.jnp</groupId>
      <artifactId>grapes</artifactId>
    </dependency>
    <!-- djl runtime -->
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>model-zoo</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-model-zoo</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-native-cpu</artifactId>
      <classifier>${djl.pytorch.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>ai.djl.pytorch</groupId>
      <artifactId>pytorch-jni</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-djl-runtime</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib/djl</outputDirectory>
              <includeGroupIds>ai.djl,ai.djl.pytorch</includeGroupIds>
              <includeScope>runtime</includeScope> <!-- include transitive dependencies, e.g. `gson` and `slf4j` -->
            </configuration>
          </execution>
          <execution>
            <id>copy-jclara</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib/clara</outputDirectory>
              <includeGroupIds>org.jlab.coda</includeGroupIds>
              <includeArtifactIds>jclara</includeArtifactIds>
              <includeTypes>jar</includeTypes>
            </configuration>
          </execution>
          <execution>
            <id>copy-grapes</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib/grapes</outputDirectory>
              <includeGroupIds>org.jlab.jnp</includeGroupIds>
              <includeArtifactIds>grapes</includeArtifactIds>
              <includeTypes>jar</includeTypes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
